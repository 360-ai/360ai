      "id": "b2000000-0011-4000-8000-000000000011",
      "name": "Lead fortschreiben",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1420,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Kontaktereignis protokollieren. Die verwendeten Argumente gehoeren hierher\n// und nicht an den Lead: im Telefonat werden andere genutzt als in der Mail.\nconst g = $('Gespraech auswerten').first().json;\nconst p = $('Freigabe pruefen').first().json;\n\nconst zeilen = [{\n  json: {\n    activity_id: 'A-' + Date.now(),\n    lead_id: g.lead_id,\n    datum: new Date().toISOString(),\n    typ: 'anruf',\n    richtung: 'raus',\n    verwendete_argumente: g.argumente,\n    ergebnis: g.ergebnis === 'nicht_erreicht' ? 'nicht_erreicht' : (g.freigabe ? 'zusage' : g.ergebnis),\n    notiz: g.notiz\n  }\n}];\n\nif (p.darf_entwurf) {\n  zeilen.push({\n    json: {\n      activity_id: 'A-' + (Date.now() + 1),\n      lead_id: g.lead_id,\n      datum: new Date().toISOString(),\n      typ: 'mail',\n      richtung: 'raus',\n      verwendete_argumente: g.argumente,\n      ergebnis: 'offen',\n      notiz: 'Gmail-Entwurf angelegt, Versand manuell'\n    }\n  });\n}\n\nreturn zeilen;"
      },
      "id": "b2000000-0012-4000-8000-000000000012",
      "name": "Aktivitaeten bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
