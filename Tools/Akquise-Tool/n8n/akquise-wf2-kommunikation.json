            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0005-4000-8000-000000000005",
      "name": "Entwurf erlaubt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// MIME-Nachricht bauen und fuer die Gmail-API kodieren.\n// Betreff wird RFC-2047-kodiert, damit Umlaute korrekt ankommen.\nconst d = $input.first().json;\n\nconst betreffKodiert = '=?UTF-8?B?' + Buffer.from(d.betreff, 'utf8').toString('base64') + '?=';\n\nconst mime = [\n  'To: ' + d.empfaenger,\n  'Subject: ' + betreffKodiert,\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=\"UTF-8\"',\n  'Content-Transfer-Encoding: 8bit',\n  '',\n  d.mailtext\n].join('\\r\\n');\n\nconst raw = Buffer.from(mime, 'utf8')\n  .toString('base64')\n  .replace(/\\+/g, '-')\n  .replace(/\\//g, '_')\n  .replace(/=+$/, '');\n\nreturn [{ json: { ...d, raw: raw } }];"
      },
      "id": "b2000000-0006-4000-8000-000000000006",
      "name": "Mail zusammenbauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/drafts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: { raw: $json.raw } }) }}",
        "options": {}
      },
      "id": "b2000000-0007-4000-8000-000000000007",
      "name": "Gmail-Entwurf anlegen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const antwort = $input.first().json;\n  const d = $('Freigabe pruefen').first().json;\n  if (!antwort.id) throw new Error('Gmail hat keine Entwurfs-ID geliefert');\n  return [{ json: {\n    lead_id: d.lead_id, firma: d.firma, status: d.status,\n    next_action: d.next_action, next_action_at: d.next_action_at,\n    ende_grund: d.ende_grund, wiedervorlage_am: d.wiedervorlage_am,\n    email_freigabe: 'ja', email_freigabe_am: d.heute,\n    email_freigabe_notiz: d.freigabe_notiz,\n    gmail_draft_id: antwort.id,\n    gmail_thread_id: (antwort.message && antwort.message.threadId) || '',\n    gmail_empfaenger: d.empfaenger, gmail_betreff: d.betreff,\n    _meldung: (d._status_hinweis ? d._status_hinweis + '\\n' : '')\n      + 'Entwurf liegt in Gmail: ' + d.firma + ' an ' + d.empfaenger\n      + '\\nPruefen und selbst senden. Danach erkennt der Waechter den Versand automatisch.',\n  } }];"
      },
      "id": "b2000000-0008-4000-8000-000000000008",
      "name": "Entwurfsdaten sichern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n  const lesbar = (s) => String(s || '').replace(/_/g, ' ');\n  let meldung = d.blockiert\n    ? 'Kein Entwurf moeglich fuer ' + d.firma + ': ' + d.blockiert\n    : 'Gespraech festgehalten: ' + d.firma + ' (' + lesbar(d.ergebnis) + ')'\n      + (d.next_action ? '\\nNaechste Aktion: ' + lesbar(d.next_action) + ' am ' + d.next_action_at : '');\n  if (d._status_hinweis) meldung += '\\n' + d._status_hinweis;\n  return [{ json: {\n    lead_id: d.lead_id, firma: d.firma, status: d.status,\n    next_action: d.next_action, next_action_at: d.next_action_at,\n    ende_grund: d.ende_grund, wiedervorlage_am: d.wiedervorlage_am,\n    email_freigabe: d.freigabe ? 'ja' : 'nein',\n    email_freigabe_am: d.freigabe ? d.heute : '',\n    email_freigabe_notiz: d.freigabe_notiz, _meldung: meldung,\n  } }];"
      },
      "id": "b2000000-0009-4000-8000-000000000009",
      "name": "Ohne Entwurf fortschreiben",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Felder ohne Praefix ins Sheet, Meldung getrennt weiterreichen.\nconst d = $input.first().json;\nconst zeile = {};\nfor (const [k, v] of Object.entries(d)) if (!k.startsWith('_')) zeile[k] = v;\nreturn [{ json: zeile, pairedItem: { item: 0 } }];"
      },
