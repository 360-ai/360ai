      "id": "b3000000-0002-4000-8000-000000000002",
      "name": "Leads lesen (Gmail)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -380,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nur Leads mit einem Gmail-Thread, die noch offen sind.\nconst ABGESCHLOSSEN = ['gewonnen', 'beendet'];\n\nconst kandidaten = $input.all()\n  .map((i) => i.json)\n  .filter((l) => l.gmail_thread_id && !ABGESCHLOSSEN.includes(String(l.status || '')));\n\nif (!kandidaten.length) return [];\nreturn kandidaten.map((l) => ({ json: l }));"
      },
      "id": "b3000000-0003-4000-8000-000000000003",
      "name": "Kandidaten filtern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        -160
      ]
    },
    {
      "parameters": {
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/threads/{{ $json.gmail_thread_id }}?format=metadata&metadataHeaders=From&metadataHeaders=To&metadataHeaders=Subject&metadataHeaders=Auto-Submitted&metadataHeaders=X-Autoreply&metadataHeaders=Date",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "b3000000-0004-4000-8000-000000000004",
      "name": "Thread lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Versand und Antwort aus EINEM Thread-Abruf ableiten.\n//\n// Bewusst nicht ueber die Message-ID des Entwurfs: Sie aendert sich, sobald\n// der Entwurf in Gmail bearbeitet wird - und genau das passiert vor jedem\n// Versand. Ein Entwurf traegt im Thread das Label DRAFT; eine tatsaechlich\n// gesendete Nachricht traegt SENT ohne DRAFT.\nconst EIGENE_ADRESSE = 'info@360-ai.org';\nconst FOLLOWUP_TAGE = 14;\n\nconst leads = $('Kandidaten filtern').all().map((i) => i.json);\nconst antworten = $input.all().map((i) => i.json);\nconst heute = new Date().toISOString().slice(0, 10);\n\nconst kopf = (m, name) => {\n  const h = (m.payload && m.payload.headers) || [];\n  const t = h.find((x) => String(x.name).toLowerCase() === name.toLowerCase());\n  return t ? String(t.value) : '';\n};\n\nconst ergebnisse = [];\n\nfor (let i = 0; i < leads.length; i++) {\n  const lead = leads[i];\n  const thread = antworten[i] || {};\n\n  if (!thread.messages || !Array.isArray(thread.messages)) {\n    ergebnisse.push({\n      json: { _aenderung: false, _meldung: 'Thread von ' + (lead.firma || lead.lead_id) + ' nicht lesbar - bitte selbst nachsehen.', _melden: true, lead_id: lead.lead_id }\n    });\n    continue;\n  }\n\n  const nachrichten = thread.messages;\n  const gesendet = nachrichten.filter((m) => {\n    const l = m.labelIds || [];\n    return l.includes('SENT') && !l.includes('DRAFT');\n  });\n  const entwuerfeOffen = nachrichten.some((m) => (m.labelIds || []).includes('DRAFT'));\n\n  // Eingehende Nachrichten, ohne eigene und ohne Automatik.\n  const eingehend = nachrichten.filter((m) => {\n    const l = m.labelIds || [];\n    if (l.includes('SENT') || l.includes('DRAFT')) return false;\n    const von = kopf(m, 'From').toLowerCase();\n    return !von.includes(EIGENE_ADRESSE.toLowerCase());\n  });\n\n  const istAutomatik = (m) => {\n    if (kopf(m, 'Auto-Submitted').toLowerCase().includes('auto-')) return true;\n    if (kopf(m, 'X-Autoreply')) return true;\n    return /abwesen|out of office|automatische antwort|autoreply|urlaub/i.test(kopf(m, 'Subject'));\n  };\n  const istUnzustellbar = (m) => {\n    const von = kopf(m, 'From').toLowerCase();\n    if (/mailer-daemon|postmaster/.test(von)) return true;\n    return /unzustellbar|undelivered|delivery status notification|failure notice/i.test(kopf(m, 'Subject'));\n  };\n\n  const bounces = eingehend.filter(istUnzustellbar);\n  const automatik = eingehend.filter((m) => !istUnzustellbar(m) && istAutomatik(m));\n  const echteAntworten = eingehend.filter((m) => !istUnzustellbar(m) && !istAutomatik(m));\n\n  const aktualisierung = { lead_id: lead.lead_id };\n  let meldung = null;\n  let aenderung = false;\n\n  // 1. Unzustellbarkeit hat Vorrang.\n  if (bounces.length) {\n    aktualisierung.status = 'beendet';\n    aktualisierung.ende_grund = 'mail_unzustellbar';\n    aktualisierung.next_action = '';\n    aktualisierung.next_action_at = '';\n    meldung = 'Mail an ' + (lead.firma || lead.lead_id) + ' ist unzustellbar (' + (lead.gmail_empfaenger || '') + '). Lead beendet - Adresse pruefen.';\n    aenderung = true;\n\n  // 2. Echte Antwort.\n  } else if (echteAntworten.length) {\n    aktualisierung.status = 'qualifiziert';\n    aktualisierung.next_action = 'antwort_bearbeiten';\n    aktualisierung.next_action_at = heute;\n    meldung = 'Antwort von ' + (lead.firma || lead.lead_id) + ': ' + kopf(echteAntworten[echteAntworten.length - 1], 'From');\n    aenderung = true;\n\n  // 3. Versand erkannt, aber noch keine Antwort.\n  } else if (gesendet.length && !lead.unterlagen_gesendet_am) {\n    const letzte = gesendet[gesendet.length - 1];\n    const datum = letzte.internalDate\n      ? new Date(Number(letzte.internalDate)).toISOString().slice(0, 10)\n      : heute;\n    const faellig = new Date(datum);\n    faellig.setDate(faellig.getDate() + FOLLOWUP_TAGE);\n\n    aktualisierung.status = 'kontaktiert';\n    aktualisierung.unterlagen_gesendet_am = datum;\n    aktualisierung.next_action = 'followup_call';\n    aktualisierung.next_action_at = faellig.toISOString().slice(0, 10);\n    meldung = 'Versand erkannt: ' + (lead.firma || lead.lead_id) + ' am ' + datum + '. Nachfassen am ' + aktualisierung.next_action_at + '.';\n    aenderung = true;\n\n  // 4. Nichts passiert - Entwurf liegt noch da.\n  } else if (entwuerfeOffen && !gesendet.length) {\n    const alter = lead.email_freigabe_am\n      ? Math.floor((Date.now() - new Date(lead.email_freigabe_am).getTime()) / 86400000)\n      : 0;\n    if (alter >= 5) {\n      meldung = 'Der Entwurf fuer ' + (lead.firma || lead.lead_id) + ' liegt seit ' + alter + ' Tagen unversendet in Gmail.';\n      ergebnisse.push({ json: { _aenderung: false, _melden: true, _meldung: meldung, lead_id: lead.lead_id } });\n      continue;\n    }\n  }\n\n  // Abwesenheitsnotizen werden bewusst nicht als Antwort gewertet.\n  if (automatik.length && !echteAntworten.length && !bounces.length) {\n    meldung = (meldung ? meldung + ' ' : '')\n      + 'Hinweis: Abwesenheitsnotiz von ' + (lead.firma || lead.lead_id) + ' erhalten - zaehlt nicht als Antwort, Nachfassen laeuft weiter.';\n  }\n\n  ergebnisse.push({\n    json: {\n      ...aktualisierung,\n      _aenderung: aenderung,\n      _melden: Boolean(meldung),\n      _meldung: meldung,\n      _firma: lead.firma || lead.lead_id,\n      _argumente: ''\n    }\n  });\n}\n\nreturn ergebnisse;"
      },
      "id": "b3000000-0005-4000-8000-000000000005",
      "name": "Thread auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
