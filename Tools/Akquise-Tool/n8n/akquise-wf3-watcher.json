    {
      "parameters": {
        "jsCode": "// Nur Leads mit tatsaechlicher Zustandsaenderung ins Sheet schreiben.\nreturn $input.all()\n  .filter((i) => i.json._aenderung)\n  .map((i) => {\n    const zeile = {};\n    for (const [k, v] of Object.entries(i.json)) if (!k.startsWith('_')) zeile[k] = v;\n    return { json: zeile };\n  });"
      },
