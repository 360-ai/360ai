      "id": "b3000000-0021-4000-8000-000000000021",
      "name": "Leads lesen (Morgen)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -380,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Morgenmeldung. Laeuft zehn Minuten nach der Gmail-Pruefung und sieht\n// deren Ergebnisse deshalb bereits.\nconst ABGESCHLOSSEN = ['gewonnen', 'beendet'];\nconst heute = new Date().toISOString().slice(0, 10);\n\nconst leads = $input.all().map((i) => i.json).filter((l) => l.lead_id);\n\nconst faellig = (d) => d && String(d).slice(0, 10) <= heute;\nconst offen = (l) => !ABGESCHLOSSEN.includes(String(l.status || ''));\n\nconst anrufe = leads.filter((l) => offen(l) && l.next_action === 'anruf' && faellig(l.next_action_at));\nconst nachfassen = leads.filter((l) => offen(l) && l.next_action === 'followup_call' && faellig(l.next_action_at));\nconst antworten = leads.filter((l) => offen(l) && l.next_action === 'antwort_bearbeiten');\nconst wiedervorlagen = leads.filter((l) => faellig(l.wiedervorlage_am));\nconst zuAnalysieren = leads.filter((l) => String(l.status) === 'neu');\nconst entwuerfe = leads.filter((l) => offen(l) && l.gmail_draft_id && !l.unterlagen_gesendet_am);\n\n// Loeschfrist: 24 Monate nach Beendigung ohne Geschaeftsbeziehung.\nconst grenze = new Date(); grenze.setMonth(grenze.getMonth() - 24);\nconst zuAnonymisieren = leads.filter((l) =>\n  ['kein_bedarf', 'ungeeignet'].includes(String(l.ende_grund || ''))\n  && l.unterlagen_gesendet_am\n  && new Date(l.unterlagen_gesendet_am) < grenze\n);\n\nconst nachScore = (a, b) => Number(b.akquise_score || 0) - Number(a.akquise_score || 0);\nconst zeile = (l) => '  · ' + (l.firma || l.lead_id) + (l.akquise_score ? ' (' + l.akquise_score + ')' : '') + (l.telefon ? ' — ' + l.telefon : '');\n\nconst teile = [];\nif (antworten.length) teile.push('*Antworten bearbeiten (' + antworten.length + ')*\\n' + antworten.sort(nachScore).map(zeile).join('\\n'));\nif (anrufe.length) teile.push('*Anrufe faellig (' + anrufe.length + ')*\\n' + anrufe.sort(nachScore).map(zeile).join('\\n'));\nif (nachfassen.length) teile.push('*Nachfassen (' + nachfassen.length + ')*\\n' + nachfassen.sort(nachScore).map(zeile).join('\\n'));\nif (wiedervorlagen.length) teile.push('*Wiedervorlage (' + wiedervorlagen.length + ')*\\n' + wiedervorlagen.map(zeile).join('\\n'));\nif (entwuerfe.length) teile.push('*Entwuerfe warten auf Versand (' + entwuerfe.length + ')*\\n' + entwuerfe.map(zeile).join('\\n'));\nif (zuAnalysieren.length) teile.push('*Warten auf Analyse (' + zuAnalysieren.length + ')*\\n' + zuAnalysieren.map(zeile).join('\\n'));\nif (zuAnonymisieren.length) teile.push('*Loeschfrist erreicht (' + zuAnonymisieren.length + ')*\\nPersonendaten entfernen, Firma und Analyse koennen bleiben:\\n' + zuAnonymisieren.map(zeile).join('\\n'));\n\nif (!teile.length) return [];\n\nreturn [{ json: { text: 'Guten Morgen. Heute:\\n\\n' + teile.join('\\n\\n') } }];"
      },
