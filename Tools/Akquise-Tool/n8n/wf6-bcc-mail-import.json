    {
      "parameters": {
        "jsCode": "// Sheet-Leseoperationen koennen viele Items liefern. Der naechste Read darf\n  // trotzdem nur einmal laufen, sonst vervielfacht sich die API-Last pro Zeile.\n  return [{ json: { weiter: true } }];"
